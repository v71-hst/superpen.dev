{
  "name": "pen-editor-remake",
  "displayName": "Superpencil",
  "description": "Visual editor for .pen design files with a pen.dev-style interface.",
  "version": "0.1.0",
  "publisher": "local-remake",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/v71-hst/superpen.dev.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superpencil",
          "title": "Superpencil",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "superpencil": [
        {
          "id": "superpencil.designs",
          "name": "Designs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "superpencil.designs",
        "contents": "No .pen designs in this workspace yet.\n[New .pen Design File](command:penEditorRemake.newFile)\n[Open .pen File…](command:penEditorRemake.open)\nLet Claude Code or Codex read and edit your designs:\n[Register with Claude Code](command:penEditorRemake.registerMcp)\n[Register with Codex](command:penEditorRemake.registerMcpCodex)"
      }
    ],
    "customEditors": [
      {
        "viewType": "penEditorRemake.editor",
        "displayName": "Superpencil",
        "selector": [
          {
            "filenamePattern": "*.pen"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "penEditorRemake.open",
        "title": "Open in Superpencil",
        "category": "Superpencil",
        "icon": {
          "light": "media/button-light.svg",
          "dark": "media/button-dark.svg"
        }
      },
      {
        "command": "penEditorRemake.registerMcp",
        "title": "Register MCP Server with Claude Code",
        "category": "Superpencil",
        "icon": "$(plug)"
      },
      {
        "command": "penEditorRemake.registerMcpCodex",
        "title": "Register MCP Server with Codex",
        "category": "Superpencil"
      },
      {
        "command": "penEditorRemake.newFile",
        "title": "New .pen Design File",
        "category": "Superpencil",
        "icon": "$(add)"
      },
      {
        "command": "penEditorRemake.openAsJson",
        "title": "Open .pen File as JSON",
        "category": "Superpencil"
      },
      {
        "command": "penEditorRemake.openInEditor",
        "title": "Open in Superpencil",
        "category": "Superpencil"
      },
      {
        "command": "penEditorRemake.refreshDesigns",
        "title": "Refresh Designs",
        "category": "Superpencil",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "penEditorRemake.openAsJson",
          "when": "resourceExtname == .pen",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "penEditorRemake.open",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "penEditorRemake.newFile",
          "when": "view == superpencil.designs",
          "group": "navigation@1"
        },
        {
          "command": "penEditorRemake.refreshDesigns",
          "when": "view == superpencil.designs",
          "group": "navigation@2"
        },
        {
          "command": "penEditorRemake.registerMcp",
          "when": "view == superpencil.designs",
          "group": "more"
        },
        {
          "command": "penEditorRemake.registerMcpCodex",
          "when": "view == superpencil.designs",
          "group": "more"
        }
      ],
      "view/item/context": [
        {
          "command": "penEditorRemake.openAsJson",
          "when": "view == superpencil.designs && viewItem == penFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "penEditorRemake.refreshDesigns",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "start": "node start.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:webview": "vite build",
    "build:extension": "esbuild extension/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build:mcp": "esbuild extension/mcp.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/mcp.cjs",
    "build": "npm run build:webview && npm run build:extension && npm run build:mcp",
    "package": "npm run build && vsce package --no-dependencies --skip-license -o release/superpen.vsix"
  },
  "dependencies": {
    "feather-icons": "4.29.2",
    "imagetracerjs": "1.2.6",
    "immer": "10.1.1",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svg-path-bbox": "2.1.0",
    "svgpath": "2.6.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/feather-icons": "4.29.4",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "4.3.2",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "zod": "3.25.76"
  }
}
