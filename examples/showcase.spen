              "fontWeight": "800",
              "letterSpacing": -1,
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "statFoot",
              "content": "vs. last 30 days",
              "fontFamily": "$font",
              "fontSize": 12,
              "fill": "$text-dim"
            }
          ]
        },
        {
          "type": "frame",
          "id": "featCard",
          "name": "Card/Feature",
          "reusable": true,
          "width": 300,
          "layout": "vertical",
          "gap": 14,
          "padding": 28,
          "cornerRadius": "$radius",
          "fill": "$surface-2",
          "stroke": "$border",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "featIconWrap",
              "name": "Icon tile",
              "width": 44,
              "height": 44,
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "cornerRadius": 12,
              "fill": "#7C3AED2E",
              "children": [
                {
                  "type": "icon",
                  "id": "featIcon",
                  "library": "lucide",
                  "icon": "layers",
                  "width": 22,
                  "height": 22,
                  "fill": "#C4B5FD"
                }
              ]
            },
            {
              "type": "text",
              "id": "featTitle",
              "content": "Feature title",
              "fontFamily": "$font",
              "fontSize": 18,
              "fontWeight": "700",
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "featBody",
              "content": "Short description of the feature goes here.",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fill": "$text-dim"
            }
          ]
        },
        {
          "type": "frame",
          "id": "stepCard",
          "name": "Card/Step",
          "reusable": true,
          "width": 300,
          "layout": "vertical",
          "gap": 14,
          "padding": 24,
          "cornerRadius": "$radius",
          "fill": "$surface-2",
          "stroke": "$border",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "stepHead",
              "name": "Header",
              "width": "fill_container",
              "layout": "horizontal",
              "justifyContent": "space_between",
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "stepNum",
                  "name": "Number",
                  "width": 32,
                  "height": 32,
                  "cornerRadius": 999,
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "fill": {
                    "type": "gradient",
                    "gradientType": "linear",
                    "rotation": 225,
                    "colors": [
                      {
                        "color": "$accent-2",
                        "position": 0
                      },
                      {
                        "color": "$accent",
                        "position": 1
                      }
                    ]
                  },
                  "children": [
                    {
                      "type": "text",
                      "id": "stepNumT",
                      "content": "1",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fill": "$text",
                      "fontWeight": "800"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "stepKey",
                  "layout": "horizontal",
                  "padding": [
                    4,
                    10
                  ],
                  "cornerRadius": 8,
                  "fill": "#FFFFFF0F",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "children": [
                    {
                      "type": "text",
                      "id": "stepKeyT",
                      "content": "I",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fill": "$text",
                      "fontWeight": "600"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "stepTitle",
              "content": "Step title",
              "fontFamily": "$font",
              "fontSize": 18,
              "fill": "$text",
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "stepBody",
              "content": "What to do and what happens.",
              "fontFamily": "$font",
              "fontSize": 14,
              "fill": "$text-dim",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "lineHeight": 1.55
            }
          ]
        }
      ]
    }
  ],
  "variables": {
    "bg": {
      "type": "color",
      "value": "#070A14"
    },
    "surface": {
      "type": "color",
      "value": "#0F1424"
    },
    "surface-2": {
      "type": "color",
      "value": "#161C30"
    },
    "border": {
      "type": "color",
      "value": "#FFFFFF14"
    },
    "text": {
      "type": "color",
      "value": "#F8FAFC"
    },
    "text-dim": {
      "type": "color",
      "value": "#94A3B8"
    },
    "accent": {
      "type": "color",
      "value": "#7C3AED"
    },
    "accent-2": {
      "type": "color",
      "value": "#22D3EE"
    },
    "success": {
      "type": "color",
      "value": "#34D399"
    },
    "warning": {
      "type": "color",
      "value": "#FBBF24"
    },
    "radius": {
      "type": "number",
      "value": 20
    },
    "font": {
      "type": "string",
      "value": "Inter"
    }
  }
}