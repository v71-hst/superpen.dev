{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "showcase",
      "name": "Superpencil Showcase",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": "fit_content",
      "layout": "vertical",
      "gap": 56,
      "padding": 64,
      "clip": true,
      "fill": [
        {
          "type": "color",
          "color": "$bg"
        },
        {
          "type": "gradient",
          "gradientType": "radial",
          "center": {
            "x": 0.15,
            "y": 0
          },
          "size": {
            "width": 1.2,
            "height": 0.6
          },
          "colors": [
            {
              "color": "#7C3AED33",
              "position": 0
            },
            {
              "color": "#7C3AED00",
              "position": 1
            }
          ]
        }
      ],
      "children": [
        {
          "type": "frame",
          "id": "nav",
          "name": "Nav",
          "width": "fill_container",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "brand",
              "name": "Brand",
              "layout": "horizontal",
              "gap": 10,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "brandMark",
                  "width": 34,
                  "height": 34,
                  "cornerRadius": 10,
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "fill": {
                    "type": "gradient",
                    "gradientType": "linear",
                    "rotation": 225,
                    "colors": [
                      {
                        "color": "$accent-2",
                        "position": 0
                      },
                      {
                        "color": "$accent",
                        "position": 1
                      }
                    ]
                  },
                  "children": [
                    {
                      "type": "icon",
                      "id": "brandIcon",
                      "library": "lucide",
                      "icon": "pencil",
                      "width": 18,
                      "height": 18,
                      "fill": "$text"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "brandName",
                  "content": "Superpencil",
                  "fontFamily": "$font",
                  "fontSize": 19,
                  "fill": "$text",
                  "fontWeight": "800",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "brandDomain",
                  "content": "superpen.dev",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 13,
                  "fill": "$text-dim",
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "navLinks",
              "name": "Links",
              "layout": "horizontal",
              "gap": 28,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "nl1",
                  "content": "Try it",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fill": "$text-dim",
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "nl2",
                  "content": "Features",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fill": "$text-dim",
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "nl3",
                  "content": "Formats",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fill": "$text-dim",
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "nl4",
                  "content": "AI",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fill": "$text-dim",
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "nl5",
                  "content": "Roblox",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fill": "$text-dim",
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "navTag",
              "name": "Tag",
              "layout": "horizontal",
              "gap": 8,
              "alignItems": "center",
              "padding": [
                8,
                14
              ],
              "cornerRadius": 999,
              "fill": "#34D3991A",
              "stroke": "#34D39940",
              "strokeWidth": 1,
              "children": [
                {
                  "type": "icon",
                  "id": "navTagI",
                  "library": "lucide",
                  "icon": "puzzle",
                  "width": 14,
                  "height": 14,
                  "fill": "$success"
                },
                {
                  "type": "text",
                  "id": "navTagT",
                  "content": "Free VS Code extension",
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fill": "$text",
                  "fontWeight": "600"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "hero",
          "name": "Hero",
          "width": "fill_container",
          "height": 500,
          "layout": "vertical",
          "gap": 22,
          "padding": 56,
          "justifyContent": "center",
          "cornerRadius": 28,
          "clip": true,
          "fill": {
            "type": "shader",
            "url": "./shaders/showcase-waves.glsl",
            "uniforms": {
              "u_speed": 0.35
            }
          },
          "stroke": "#FFFFFF1F",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "heroBadge",
              "name": "Badge",
              "layout": "horizontal",
              "gap": 8,
              "padding": [
                6,
                12
              ],
              "cornerRadius": 999,
              "alignItems": "center",
              "fill": "#FFFFFF14",
              "stroke": "#FFFFFF26",
              "strokeWidth": 1,
              "children": [
                {
                  "type": "ellipse",
                  "id": "heroDot",
                  "width": 8,
                  "height": 8,
                  "fill": "$success",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "color": "#34D399",
                    "offset": {
                      "x": 0,
                      "y": 0
                    },
                    "blur": 8
                  }
                },
                {
                  "type": "text",
                  "id": "heroBadgeText",
                  "content": "NEW · Eyedropper, Codex support and .spen files",
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fill": "$text",
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "heroTitle",
              "content": "Design game & app UI\nright inside VS Code.",
              "fontFamily": "$font",
              "fontSize": 62,
              "fill": "$text",
              "fontWeight": "800",
              "textGrowth": "fixed-width",
              "width": 780,
              "lineHeight": 1.05,
              "letterSpacing": -2
            },
            {
              "type": "text",
              "id": "heroSub",
              "content": "Superpencil is a visual editor for .spen and pen.dev .pen files. Build screens with components, live scripts and GPU shaders, and let Claude Code or Codex design alongside you.",
              "fontFamily": "$font",
              "fontSize": 18,
              "fill": "#CBD5E1",
              "textGrowth": "fixed-width",
              "width": 640,
              "lineHeight": 1.55
            },
            {
              "type": "frame",
              "id": "heroCtas",
              "name": "Actions",
              "layout": "horizontal",
              "gap": 12,
              "children": [
                {
                  "type": "ref",
                  "id": "ctaInstall",
                  "ref": "btnPrimary",
                  "width": null,
                  "height": "fill_container",
                  "descendants": {
                    "bpIcon": {
                      "icon": "download"
                    },
                    "bpLabel": {
                      "content": "Install the VSIX"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "ctaGuide",
                  "ref": "btnGhost",
                  "width": null,
                  "height": "fill_container",
                  "descendants": {
                    "bgIcon": {
                      "icon": "arrow-down"
                    },
                    "bgLabel": {
                      "content": "Try it on this page"
                    }
                  }
                }
              ]
            },
            {
              "type": "frame",
              "id": "heroHint",
              "name": "Hint",
              "layout": "horizontal",
              "gap": 8,
              "alignItems": "center",
              "padding": [
                6,
                12
              ],
              "cornerRadius": 999,
              "fill": "#22D3EE14",
              "stroke": "#22D3EE33",
              "strokeWidth": 1,
              "children": [
                {
                  "type": "icon",
                  "id": "heroHintI",
                  "library": "lucide",
                  "icon": "info",
                  "width": 14,
                  "height": 14,
                  "fill": "$accent-2"
                },
                {
                  "type": "text",
                  "id": "heroHintT",
                  "content": "This background is a live GLSL shader: shaders/showcase-waves.glsl",
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fill": "#A5F3FC",
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "ellipse",
              "id": "orb",
              "name": "Orb (shader)",
              "layoutPosition": "absolute",
              "x": 900,
              "y": 90,
              "width": 300,
              "height": 300,
              "fill": {
                "type": "shader",
                "url": "./shaders/showcase-orb.glsl"
              },
              "effect": {
                "type": "shadow",
                "shadowType": "outer",
                "color": "#F472B655",
                "offset": {
                  "x": 0,
                  "y": 0
                },
                "blur": 80
              }
            }
          ]
        },
        {
          "type": "frame",
          "id": "facts",
          "name": "Facts",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 20,
          "children": [
            {
              "type": "ref",
              "id": "fFormats",
              "ref": "statCard",
              "width": "fill_container",
              "height": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "File formats"
                },
                "statValue": {
                  "content": ".spen + .pen",
                  "fontSize": 32
                },
                "statTop/statBadge": {
                  "fill": "#34D3991F"
                },
                "statTop/statBadge/statArrow": {
                  "icon": "arrow-left-right",
                  "fill": "$success"
                },
                "statTop/statBadge/statDelta": {
                  "content": "lossless",
                  "fill": "$success"
                },
                "statFoot": {
                  "content": "Same JSON: save a copy as either"
                }
              }
            },
            {
              "type": "ref",
              "id": "fTools",
              "ref": "statCard",
              "width": "fill_container",
              "height": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "MCP tools"
                },
                "statValue": {
                  "content": "27",
                  "fontSize": 32
                },
                "statTop/statBadge": {
                  "fill": "#22D3EE1F"
                },
                "statTop/statBadge/statArrow": {
                  "icon": "bot",
                  "fill": "#67E8F9"
                },
                "statTop/statBadge/statDelta": {
                  "content": "AI",
                  "fill": "#67E8F9"
                },
                "statFoot": {
                  "content": "Read, edit, screenshot and lint"
                }
              }
            },
            {
              "type": "ref",
              "id": "fLock",
              "ref": "statCard",
              "width": "fill_container",
              "height": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "Edit locks"
                },
                "statValue": {
                  "content": "1 per file",
                  "fontSize": 32
                },
                "statTop/statBadge": {
                  "fill": "#FBBF241F"
                },
                "statTop/statBadge/statArrow": {
                  "icon": "lock",
                  "fill": "$warning"
                },
                "statTop/statBadge/statDelta": {
                  "content": "safe",
                  "fill": "$warning"
                },
                "statFoot": {
                  "content": "Chats never overwrite each other"
                }
              }
            },
            {
              "type": "ref",
              "id": "fZoom",
              "ref": "statCard",
              "width": "fill_container",
              "height": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "Huge files"
                },
                "statValue": {
                  "content": "33% zoom",
                  "fontSize": 32
                },
                "statTop/statBadge": {
                  "fill": "#34D3991F"
                },
                "statTop/statBadge/statArrow": {
                  "icon": "gauge",
                  "fill": "$success"
                },
                "statTop/statBadge/statDelta": {
                  "content": "fast",
                  "fill": "$success"
                },
                "statFoot": {
                  "content": "Below it, frames draw as images"
                }
              }
            }
          ]
        },
        {
          "type": "frame",
          "id": "tryIt",
          "name": "Try it on this page",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 24,
          "children": [
            {
              "type": "frame",
              "id": "tryItHead",
              "name": "Heading",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "tryItEye",
                  "content": "START HERE",
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fill": "$accent-2",
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "tryItTitle",
                  "content": "Try it on this page",
                  "fontFamily": "$font",
                  "fontSize": 34,
                  "fill": "$text",
                  "fontWeight": "800",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "tryItSub",
                  "content": "Everything on this canvas is editable. Four quick things to try, each one shows a different part of Superpencil.",
                  "fontFamily": "$font",
                  "fontSize": 16,
                  "fill": "$text-dim",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "lineHeight": 1.55
                }
              ]
            },
            {
              "type": "frame",
              "id": "steps",
              "name": "Steps",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 20,
              "children": [
                {
                  "type": "ref",
                  "id": "st1",
                  "ref": "stepCard",
                  "width": "fill_container",
                  "height": "fill_container",
                  "descendants": {
                    "stepHead/stepNum/stepNumT": {
                      "content": "1"
                    },
                    "stepHead/stepKey/stepKeyT": {
                      "content": "I"
                    },
                    "stepTitle": {
                      "content": "Pick a colour"
                    },
                    "stepBody": {
                      "content": "Press I and click any layer to copy its colour. Select a layer first to paint it instead (hold Shift for its stroke)."
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "st2",
                  "ref": "stepCard",
                  "width": "fill_container",
                  "height": "fill_container",
                  "descendants": {
                    "stepHead/stepNum/stepNumT": {
                      "content": "2"
                    },
                    "stepHead/stepKey/stepKeyT": {
                      "content": "Ctrl Alt K"
                    },
                    "stepTitle": {
                      "content": "Edit a component"
                    },
                    "stepBody": {
                      "content": "These cards are instances of Card/Step in the Components frame on the right. Change it there and every copy updates."
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "st3",
                  "ref": "stepCard",
                  "width": "fill_container",
                  "height": "fill_container",
                  "descendants": {
                    "stepHead/stepNum/stepNumT": {
                      "content": "3"
                    },
                    "stepHead/stepKey/stepKeyT": {
                      "content": "Design panel"
                    },
                    "stepTitle": {
                      "content": "Tweak a script"
                    },
                    "stepBody": {
                      "content": "Select the bar chart below. Its values, colours and highlight are inputs of scripts/showcase-bars.js."
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "st4",
                  "ref": "stepCard",
                  "width": "fill_container",
                  "height": "fill_container",
                  "descendants": {
                    "stepHead/stepNum/stepNumT": {
                      "content": "4"
                    },
                    "stepHead/stepKey/stepKeyT": {
                      "content": "MCP"
                    },
                    "stepTitle": {
                      "content": "Ask an AI"
                    },
                    "stepBody": {
                      "content": "Register the MCP server, then ask Claude Code or Codex: \"select showcase.spen and add a pricing section\"."
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "live",
          "name": "Scripts draw content for you",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 24,
          "children": [
            {
              "type": "frame",
              "id": "liveHead",
              "name": "Heading",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "liveEye",
                  "content": "LIVE CONTENT",
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fill": "$accent-2",
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "liveTitle",
                  "content": "Scripts draw content for you",
                  "fontFamily": "$font",
                  "fontSize": 34,
                  "fill": "$text",
                  "fontWeight": "800",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "liveSub",
                  "content": "A script node runs a JavaScript file and draws whatever it returns. Its @input lines become controls in the Design panel, and editing the .js file next to your design updates the canvas straight away.",
                  "fontFamily": "$font",
                  "fontSize": 16,
                  "fill": "$text-dim",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "lineHeight": 1.55
                }
              ]
            },
            {
              "type": "frame",
              "id": "chartsRow",
              "name": "Charts",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 20,
              "children": [
                {
                  "type": "frame",
                  "id": "revCard",
                  "name": "Revenue card",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 18,
                  "padding": 28,
                  "cornerRadius": "$radius",
                  "fill": "$surface",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "children": [
                    {
                      "type": "frame",
                      "id": "revHead",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "justifyContent": "space_between",
                      "alignItems": "end",
                      "children": [
                        {
                          "type": "frame",
                          "id": "revTitles",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "revLabel",
                              "content": "Script node: bar chart",
                              "fontFamily": "$font",
                              "fontSize": 14,
                              "fontWeight": "500",
                              "fill": "$text-dim"
                            },
                            {
                              "type": "text",
                              "id": "revValue",
                              "content": "Monthly visits",
                              "fontFamily": "$font",
                              "fontSize": 32,
                              "fontWeight": "800",
                              "letterSpacing": -1,
                              "fill": "$text"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "revNote",
                          "content": "scripts/showcase-bars.js",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fill": "$text-dim"
                        }
                      ]
                    },
                    {
                      "type": "script",
                      "id": "barsScript",
                      "name": "Bar chart (script)",
                      "width": 856,
                      "height": 260,
                      "scriptUri": "./scripts/showcase-bars.js",
                      "inputs": {
                        "highlight": 11
                      }
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ringCard",
                  "name": "Uptime card",
                  "width": 380,
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 28,
                  "alignItems": "center",
                  "cornerRadius": "$radius",
                  "fill": "$surface",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "children": [
                    {
                      "type": "text",
                      "id": "ringTitle",
                      "content": "Script node: progress ring",
                      "width": "fill_container",
                      "textGrowth": "fixed-width",
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "500",
                      "fill": "$text-dim"
                    },
                    {
                      "type": "script",
                      "id": "ringScript",
                      "name": "Progress ring (script)",
                      "width": 260,
                      "height": 260,
                      "scriptUri": "./scripts/showcase-ring.js",
                      "inputs": {
                        "value": 99.2,
                        "label": "Uptime"
                      }
                    },
                    {
                      "type": "text",
                      "id": "ringFoot",
                      "content": "scripts/showcase-ring.js",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 12,
                      "fill": "$text-dim"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "features",
          "name": "Everything in Superpencil",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "featuresHead",
              "name": "Heading",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "featuresEye",
                  "content": "FEATURES",
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fill": "$accent-2",
                  "fontWeight": "700",
                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "featuresTitle",
                  "content": "Everything in Superpencil",
                  "fontFamily": "$font",
                  "fontSize": 34,
                  "fill": "$text",
                  "fontWeight": "800",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "featuresSub",
                  "content": "A pen.dev-style canvas with the extras game and app designers need.",
                  "fontFamily": "$font",
                  "fontSize": 16,
                  "fill": "$text-dim",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "lineHeight": 1.55
                }
              ]
            },
            {
              "type": "frame",
              "id": "featRow1",
              "name": "Features 1",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 20,
              "children": [
                {
                  "type": "ref",
                  "id": "fe1",
                  "ref": "featCard",
                  "width": "fill_container",
                  "height": "fill_container",
                  "descendants": {
                    "featIconWrap/featIcon": {
                      "icon": "component"
                    },
                    "featTitle": {
                      "content": "Components & states"
                    },
                    "featBody": {
                      "content": "Reusable components with hover, pressed and disabled states, per-instance overrides and theme variables."
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "fe2",
                  "ref": "featCard",
                  "width": "fill_container",
                  "height": "fill_container",
                  "descendants": {
                    "featIconWrap/featIcon": {
                      "icon": "code-xml",
                      "fill": "#67E8F9"
                    },
                    "featTitle": {
                      "content": "Script nodes"
                    },
                    "featBody": {
                      "content": "JavaScript files generate charts, rings and patterns. Inputs show up as controls in the Design panel."
                    },
                    "featIconWrap": {
                      "fill": "#22D3EE24"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "fe3",
                  "ref": "featCard",
                  "width": "fill_container",
