{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "libFrame",
      "name": "Components",
      "x": 1560,
      "y": 0,
      "width": 520,
      "height": "fit_content",
      "layout": "vertical",
      "gap": 32,
      "padding": 40,
      "cornerRadius": 24,
      "fill": "$surface",
      "stroke": "$border",
      "strokeWidth": 1,
      "children": [
        {
          "type": "text",
          "id": "libTitle",
          "content": "Component library",
          "fontFamily": "$font",
          "fontSize": 20,
          "fontWeight": "700",
          "fill": "$text"
        },
        {
          "type": "frame",
          "id": "btnPrimary",
          "name": "Button/Primary",
          "reusable": true,
          "layout": "horizontal",
          "gap": 8,
          "padding": [
            12,
            20
          ],
          "cornerRadius": 12,
          "alignItems": "center",
          "fill": {
            "type": "gradient",
            "gradientType": "linear",
            "rotation": 270,
            "colors": [
              {
                "color": "$accent",
                "position": 0
              },
              {
                "color": "#4F46E5",
                "position": 1
              }
            ]
          },
          "effect": {
            "type": "shadow",
            "shadowType": "outer",
            "color": "#7C3AED66",
            "offset": {
              "x": 0,
              "y": 8
            },
            "blur": 24
          },
          "children": [
            {
              "type": "icon",
              "id": "bpIcon",
              "library": "lucide",
              "icon": "sparkles",
              "width": 16,
              "height": 16,
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "bpLabel",
              "content": "Get started",
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "600",
              "fill": "$text"
            }
          ]
        },
        {
          "type": "frame",
          "id": "btnGhost",
          "name": "Button/Ghost",
          "reusable": true,
          "layout": "horizontal",
          "gap": 8,
          "padding": [
            12,
            20
          ],
          "cornerRadius": 12,
          "alignItems": "center",
          "fill": "#FFFFFF0D",
          "stroke": "#FFFFFF26",
          "strokeWidth": 1,
          "children": [
            {
              "type": "icon",
              "id": "bgIcon",
              "library": "lucide",
              "icon": "circle-play",
              "width": 16,
              "height": 16,
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "bgLabel",
              "content": "Watch demo",
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "600",
              "fill": "$text"
            }
          ]
        },
        {
          "type": "frame",
          "id": "statCard",
          "name": "Card/Stat",
          "reusable": true,
          "width": 300,
          "layout": "vertical",
          "gap": 10,
          "padding": 24,
          "cornerRadius": "$radius",
          "fill": "$surface-2",
          "stroke": "$border",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "statTop",
              "name": "Header",
              "width": "fill_container",
              "layout": "horizontal",
              "justifyContent": "space_between",
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "statLabel",
                  "content": "Active users",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                },
                {
                  "type": "frame",
                  "id": "statBadge",
                  "name": "Badge",
                  "layout": "horizontal",
                  "gap": 4,
                  "padding": [
                    4,
                    8
                  ],
                  "cornerRadius": 999,
                  "alignItems": "center",
                  "fill": "#34D3991F",
                  "children": [
                    {
                      "type": "icon",
                      "id": "statArrow",
                      "library": "lucide",
                      "icon": "trending-up",
                      "width": 12,
                      "height": 12,
                      "fill": "$success"
                    },
                    {
                      "type": "text",
                      "id": "statDelta",
                      "content": "+12.4%",
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "fill": "$success"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "statValue",
              "content": "48,210",
              "fontFamily": "$font",
              "fontSize": 36,
              "fontWeight": "800",
              "letterSpacing": -1,
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "statFoot",
              "content": "vs. last 30 days",
              "fontFamily": "$font",
              "fontSize": 12,
              "fill": "$text-dim"
            }
          ]
        },
        {
          "type": "frame",
          "id": "featCard",
          "name": "Card/Feature",
          "reusable": true,
          "width": 300,
          "layout": "vertical",
          "gap": 14,
          "padding": 28,
          "cornerRadius": "$radius",
          "fill": "$surface-2",
          "stroke": "$border",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "featIconWrap",
              "name": "Icon tile",
              "width": 44,
              "height": 44,
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "cornerRadius": 12,
              "fill": "#7C3AED2E",
              "children": [
                {
                  "type": "icon",
                  "id": "featIcon",
                  "library": "lucide",
                  "icon": "layers",
                  "width": 22,
                  "height": 22,
                  "fill": "#C4B5FD"
                }
              ]
            },
            {
              "type": "text",
              "id": "featTitle",
              "content": "Feature title",
              "fontFamily": "$font",
              "fontSize": 18,
              "fontWeight": "700",
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "featBody",
              "content": "Short description of the feature goes here.",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 14,
              "fill": "$text-dim"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "showcase",
      "name": "Pen Editor Showcase",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": "fit_content",
      "layout": "vertical",
      "gap": 28,
      "padding": 64,
      "clip": true,
      "fill": [
        {
          "type": "color",
          "color": "$bg"
        },
        {
          "type": "gradient",
          "gradientType": "radial",
          "center": {
            "x": 0.15,
            "y": 0
          },
          "size": {
            "width": 1.2,
            "height": 0.6
          },
          "colors": [
            {
              "color": "#7C3AED33",
              "position": 0
            },
            {
              "color": "#7C3AED00",
              "position": 1
            }
          ]
        }
      ],
      "children": [
        {
          "type": "frame",
          "id": "nav",
          "name": "Nav",
          "width": "fill_container",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "brand",
              "name": "Brand",
              "layout": "horizontal",
              "gap": 10,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "brandMark",
                  "width": 32,
                  "height": 32,
                  "cornerRadius": 9,
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "fill": {
                    "type": "gradient",
                    "gradientType": "linear",
                    "rotation": 225,
                    "colors": [
                      {
                        "color": "$accent-2",
                        "position": 0
                      },
                      {
                        "color": "$accent",
                        "position": 1
                      }
                    ]
                  },
                  "children": [
                    {
                      "type": "icon",
                      "id": "brandIcon",
                      "library": "lucide",
                      "icon": "pen-tool",
                      "width": 18,
                      "height": 18,
                      "fill": "$text"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "brandName",
                  "content": "pen editor",
                  "fontFamily": "$font",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "fill": "$text"
                }
              ]
            },
            {
              "type": "frame",
              "id": "navLinks",
              "name": "Links",
              "layout": "horizontal",
              "gap": 28,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "nl1",
                  "content": "Canvas",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                },
                {
                  "type": "text",
                  "id": "nl2",
                  "content": "Components",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                },
                {
                  "type": "text",
                  "id": "nl3",
                  "content": "Scripts",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                },
                {
                  "type": "text",
                  "id": "nl4",
                  "content": "Shaders",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                },
                {
                  "type": "text",
                  "id": "nl5",
                  "content": "MCP",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "hero",
          "name": "Hero",
          "width": "fill_container",
          "height": 440,
          "layout": "vertical",
          "gap": 22,
          "padding": 56,
          "justifyContent": "center",
          "cornerRadius": 28,
          "clip": true,
          "fill": {
            "type": "shader",
            "url": "./shaders/showcase-waves.glsl",
            "uniforms": {
              "u_speed": 0.35
            }
          },
          "stroke": "#FFFFFF1F",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "heroBadge",
              "name": "Badge",
              "layout": "horizontal",
              "gap": 8,
              "padding": [
                6,
                12
              ],
              "cornerRadius": 999,
              "alignItems": "center",
              "fill": "#FFFFFF14",
              "stroke": "#FFFFFF26",
              "strokeWidth": 1,
              "children": [
                {
                  "type": "ellipse",
                  "id": "heroDot",
                  "width": 8,
                  "height": 8,
                  "fill": "$success",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "color": "#34D399",
                    "offset": {
                      "x": 0,
                      "y": 0
                    },
                    "blur": 8
                  }
                },
                {
                  "type": "text",
                  "id": "heroBadgeText",
                  "content": "NEW · Scripts, shaders & multi-chat MCP",
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "600",
                  "fill": "$text"
                }
              ]
            },
            {
              "type": "text",
              "id": "heroTitle",
              "content": "Design, script and shade —\nright inside VS Code.",
              "textGrowth": "fixed-width",
              "width": 760,
              "lineHeight": 1.05,
              "letterSpacing": -2,
              "fontFamily": "$font",
              "fontSize": 60,
              "fontWeight": "800",
              "fill": "$text"
            },
            {
              "type": "text",
              "id": "heroSub",
              "content": "A pen.dev-compatible canvas with live components, generated charts and GPU shaders — editable by you and by Claude at the same time.",
              "textGrowth": "fixed-width",
              "width": 620,
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": 18,
              "fill": "#CBD5E1"
            },
            {
              "type": "frame",
              "id": "heroCtas",
              "name": "Actions",
              "layout": "horizontal",
              "gap": 12,
              "children": [
                {
                  "type": "ref",
                  "id": "hvdEo",
                  "ref": "btnPrimary"
                },
                {
                  "type": "ref",
                  "id": "ddFls",
                  "ref": "btnGhost"
                }
              ]
            },
            {
              "type": "ellipse",
              "id": "orb",
              "name": "Orb (shader)",
              "layoutPosition": "absolute",
              "x": 900,
              "y": 70,
              "width": 300,
              "height": 300,
              "fill": {
                "type": "shader",
                "url": "./shaders/showcase-orb.glsl"
              },
              "effect": {
                "type": "shadow",
                "shadowType": "outer",
                "color": "#F472B655",
                "offset": {
                  "x": 0,
                  "y": 0
                },
                "blur": 80
              }
            }
          ]
        },
        {
          "type": "frame",
          "id": "statsRow",
          "name": "Stats",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 20,
          "children": [
            {
              "type": "ref",
              "id": "SdJK5",
              "ref": "statCard",
              "width": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "Active designers"
                },
                "statValue": {
                  "content": "48,210"
                },
                "statTop/statBadge/statDelta": {
                  "content": "+12.4%"
                }
              }
            },
            {
              "type": "ref",
              "id": "ga4Iz",
              "ref": "statCard",
              "width": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "Frames rendered"
                },
                "statValue": {
                  "content": "3.2M"
                },
                "statTop/statBadge/statDelta": {
                  "content": "+31.0%"
                }
              }
            },
            {
              "type": "ref",
              "id": "AOBiV",
              "ref": "statCard",
              "width": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "Avg. frame time"
                },
                "statValue": {
                  "content": "5.8 ms"
                },
                "statTop/statBadge/statDelta": {
                  "content": "−95%"
                },
                "statFoot": {
                  "content": "pan & hover, 38k-node file"
                }
              }
            },
            {
              "type": "ref",
              "id": "XVr15",
              "ref": "statCard",
              "width": "fill_container",
              "descendants": {
                "statTop/statLabel": {
                  "content": "Claude chats"
                },
                "statValue": {
                  "content": "3 live"
                },
                "statTop/statBadge": {
                  "fill": "#FBBF241F"
                },
                "statTop/statBadge/statArrow": {
                  "icon": "lock",
                  "fill": "$warning"
                },
                "statTop/statBadge/statDelta": {
                  "content": "locked",
                  "fill": "$warning"
                },
                "statFoot": {
                  "content": "one edit lock per file"
                }
              }
            }
          ]
        },
        {
          "type": "frame",
          "id": "chartsRow",
          "name": "Charts",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "revCard",
              "name": "Revenue card",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "padding": 28,
              "cornerRadius": "$radius",
              "fill": "$surface",
              "stroke": "$border",
              "strokeWidth": 1,
              "children": [
                {
                  "type": "frame",
                  "id": "revHead",
                  "width": "fill_container",
                  "layout": "horizontal",
                  "justifyContent": "space_between",
                  "alignItems": "end",
                  "children": [
                    {
                      "type": "frame",
                      "id": "revTitles",
                      "layout": "vertical",
                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "revLabel",
                          "content": "Monthly revenue",
                          "fontFamily": "$font",
                          "fontSize": 14,
                          "fontWeight": "500",
                          "fill": "$text-dim"
                        },
                        {
                          "type": "text",
                          "id": "revValue",
                          "content": "1.18M USD",
                          "fontFamily": "$font",
                          "fontSize": 32,
                          "fontWeight": "800",
                          "letterSpacing": -1,
                          "fill": "$text"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "revNote",
                      "content": "Generated by scripts/showcase-bars.js",
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fill": "$text-dim"
                    }
                  ]
                },
                {
                  "type": "script",
                  "id": "barsScript",
                  "name": "Bar chart (script)",
                  "width": 856,
                  "height": 260,
                  "scriptUri": "./scripts/showcase-bars.js",
                  "inputs": {
                    "highlight": 11
                  }
                }
              ]
            },
            {
              "type": "frame",
              "id": "ringCard",
              "name": "Uptime card",
              "width": 380,
              "layout": "vertical",
              "gap": 12,
              "padding": 28,
              "alignItems": "center",
              "cornerRadius": "$radius",
              "fill": "$surface",
              "stroke": "$border",
              "strokeWidth": 1,
              "children": [
                {
                  "type": "text",
                  "id": "ringTitle",
                  "content": "Service health",
                  "width": "fill_container",
                  "textGrowth": "fixed-width",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$text-dim"
                },
                {
                  "type": "script",
                  "id": "ringScript",
                  "name": "Progress ring (script)",
                  "width": 260,
                  "height": 260,
                  "scriptUri": "./scripts/showcase-ring.js",
                  "inputs": {
                    "value": 99.2,
                    "label": "Uptime"
                  }
                },
                {
                  "type": "text",
                  "id": "ringFoot",
                  "content": "Generated by scripts/showcase-ring.js",
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fill": "$text-dim"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "featRow",
          "name": "Features",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 20,
          "children": [
            {
              "type": "ref",
              "id": "JrSux",
              "ref": "featCard",
              "width": "fill_container",
              "descendants": {
                "featIconWrap/featIcon": {
                  "icon": "component"
                },
                "featTitle": {
                  "content": "Components & tokens"
                },
                "featBody": {
                  "content": "Reusable components with per-instance overrides, themed variables and auto layout — saved as plain .pen JSON."
                }
              }
            },
            {
              "type": "ref",
              "id": "X0RC2",
              "ref": "featCard",
              "width": "fill_container",
              "descendants": {
                "featIconWrap": {
                  "fill": "#22D3EE24"
                },
                "featIconWrap/featIcon": {
                  "icon": "code-xml",
                  "fill": "#67E8F9"
                },
                "featTitle": {
                  "content": "Script nodes"
                },
                "featBody": {
                  "content": "JavaScript files generate live content — the charts above are scripts with editable inputs in the Design panel."
                }
              }
            },
            {
              "type": "ref",
              "id": "wZMGZ",
              "ref": "featCard",
              "width": "fill_container",
              "descendants": {
                "featIconWrap": {
                  "fill": "#F472B624"
                },
                "featIconWrap/featIcon": {
                  "icon": "sparkles",
                  "fill": "#F9A8D4"
                },
                "featTitle": {
                  "content": "GPU shaders"
                },
                "featBody": {
                  "content": "WebGL fills and effects with @time, @mouse, @sdf, @content and @backdrop — the hero, orb and terminal are shaders."
                }
              }
            }
          ]
        },
        {
          "type": "frame",
          "id": "terminal",
          "name": "Terminal (shader effect)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "padding": [
            28,
            32
          ],
          "cornerRadius": "$radius",
          "fill": "#05080F",
          "stroke": "#22D3EE33",
          "strokeWidth": 1,
          "effect": {
            "type": "shader",
            "url": "./shaders/showcase-scanlines.glsl",
            "uniforms": {
              "u_spacing": 3,
              "u_shift": 1.5
            }
          },
          "children": [
            {
              "type": "text",
              "id": "t1",
              "content": "❯ claude › select_file TestingUI.pen --label \"Showcase builder\"",
              "fontFamily": "JetBrains Mono",
              "fontSize": 15,
              "fill": "$accent-2"
            },
            {
              "type": "text",
              "id": "t2",
              "content": "✓ lock acquired · 0 other chats waiting",
              "fontFamily": "JetBrains Mono",
              "fontSize": 15,
              "fill": "$success"
            },
            {
              "type": "text",
              "id": "t3",
              "content": "❯ apply_operations  [insert hero, instantiate 4× Card/Stat, script charts, shaders]",
              "fontFamily": "JetBrains Mono",
              "fontSize": 15,
              "fill": "#CBD5E1"
            },
            {
              "type": "text",
              "id": "t4",
              "content": "✓ 1 undo step · screenshot verified · check_layout: no problems",
              "fontFamily": "JetBrains Mono",
              "fontSize": 15,
              "fill": "$success"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "runeHud",
      "name": "Rune Dial HUD",
      "x": 2200,
      "y": 0,
      "width": 680,
      "height": 660,
      "layout": "none",
      "clip": true,
      "fill": [
        {
          "type": "gradient",
