          "rotation": 200,
          "colors": [
            {
              "color": "#232D29",
              "position": 0
            },
            {
              "color": "#141B18",
              "position": 1
            }
          ]
        },
        {
          "type": "gradient",
          "gradientType": "radial",
          "center": {
            "x": 0.12,
            "y": 0.47
          },
          "size": {
            "width": 0.75,
            "height": 0.32
          },
          "colors": [
            {
              "color": "#3C8A5E59",
              "position": 0
            },
            {
              "color": "#3C8A5E00",
              "position": 1
            }
          ]
        },
        {
          "type": "gradient",
          "gradientType": "radial",
          "center": {
            "x": 0.62,
            "y": 0.63
          },
          "size": {
            "width": 0.7,
            "height": 0.7
          },
          "colors": [
            {
              "color": "#1B262200",
              "position": 0.5
            },
            {
              "color": "#0A0F0D80",
              "position": 1
            }
          ]
        }
