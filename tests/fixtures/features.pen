{
  "version": "2.6",
  "variables": { "brand": { "type": "color", "value": "#3366FF" } },
  "children": [
    { "type": "frame", "id": "home", "name": "Home", "x": 0, "y": 0, "width": 400, "height": 300, "fill": "#FFFFFF", "layout": "none", "children": [
      { "type": "frame", "id": "btn", "name": "Button", "reusable": true, "x": 20, "y": 20, "width": 120, "height": 40, "fill": "#3366FF", "cornerRadius": 8, "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
        "states": { "hover": { "root": { "fill": "#FF0000" } } },
        "children": [ { "type": "text", "id": "lbl", "content": "Click me", "fontSize": 14, "fill": "#FFFFFF", "fontFamily": "Inter" } ] },
      { "type": "ref", "id": "inst", "ref": "btn", "x": 20, "y": 100, "link": { "to": "about", "transition": "dissolve" } },
      { "type": "rectangle", "id": "boxA", "x": 200, "y": 20, "width": 60, "height": 60, "fill": "#D9D9D9" },
      { "type": "rectangle", "id": "boxB", "x": 300, "y": 150, "width": 60, "height": 60, "fill": "#D9D9D9" },
      { "type": "text", "id": "tiny", "x": 200, "y": 250, "content": "tiny grey", "fontSize": 8, "fill": "#EEEEEE", "fontFamily": "Inter" },
      { "type": "frame", "id": "row", "x": 20, "y": 180, "width": 160, "height": 40, "layout": "horizontal", "gap": 10, "children": [
        { "type": "rectangle", "id": "r1", "width": 40, "height": 40, "fill": "#3366FF" },
        { "type": "rectangle", "id": "r2", "width": 40, "height": 40, "fill": "#22AA55" },
        { "type": "rectangle", "id": "r3", "width": 40, "height": 40, "fill": "#AA2255" } ] }
    ] },
    { "type": "frame", "id": "about", "name": "About", "x": 500, "y": 0, "width": 400, "height": 300, "fill": "#F0F0F0", "layout": "none", "children": [
      { "type": "text", "id": "back", "x": 20, "y": 20, "content": "Back", "fontSize": 16, "fill": "#111111", "fontFamily": "Inter", "link": { "to": "__back" } } ] }
  ]
}
